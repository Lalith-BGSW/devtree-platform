&slpi_tlmm {

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&cpu_scc_dnl_ctrl_1v8_active>;

	pinctrl-1 = <&cpu_scc_dnl_ctrl_1v8_sleep>;

	qupv3_se10_2uart_tx_active: qupv3_se10_2uart_tx_active {
		mux {
			pins = "gpio10";
			function = "func1";
		};

		config {
			pins = "gpio10";
			drive-strength = <6>;
			bias-disable;
		};
	};

	qupv3_se10_2uart_rx_active: qupv3_se10_2uart_rx_active {
		mux {
			pins = "gpio11";
			function = "func1";
		};

		config {
			pins = "gpio11";
			drive-strength = <6>;
			bias-pull-up;
		};
	};
	qupv3_se10_2uart_tx_sleep:qupv3_se10_2uart_tx_sleep {
		mux {
			pins = "gpio10";
			function = "gpio";
		};
		config {
			pins = "gpio10";
			drive-strength = <6>;
			bias-disable;
		};
	};
	qupv3_se10_2uart_rx_sleep:qupv3_se10_2uart_rx_sleep{
		mux {
			pins = "gpio11";
			function = "gpio";
		};

		config {
			pins = "gpio11";
			drive-strength = <6>;
			bias-disable;
			input-enable;
		};
	};
	cpu_scc_dnl_ctrl_1v8_active: cpu_scc_dnl_ctrl_1v8_active {
		mux {
			pins ="gpio7", "gpio8", "gpio9";
			function ="gpio";
		};

		config {
			pins ="gpio7", "gpio8", "gpio9";
			drive-strength = <6>;
			bias-disable;
			output-low;
		};
	};
	cpu_scc_dnl_ctrl_1v8_sleep: cpu_scc_dnl_ctrl_1v8_sleep {
		mux {
			pins ="gpio7", "gpio8", "gpio9";
			function ="gpio";
		};

		config {
			pins ="gpio7", "gpio8", "gpio9";
			drive-strength = <8>;
			bias-disable;
			output-low;
		};
	};
	qupv3_se12_2uart_pins: qupv3_se12_2uart_pins {
		qupv3_se12_2uart_tx_active: qupv3_se12_2uart_tx_active {
			mux {
					pins = "gpio14";
					function = "func1";
				};

			config {
					pins = "gpio14";
					drive-strength = <2>;
					bias-disable;
				};
			};

			qupv3_se12_2uart_rx_active: qupv3_se12_2uart_rx_active {
				mux {
					pins = "gpio15";
					function = "func1";
				};

				config {
					pins = "gpio15";
					drive-strength = <2>;
					bias-disable;
				};
			};

			qupv3_se12_2uart_sleep: qupv3_se12_2uart_sleep {
				mux {
					pins = "gpio14", "gpio15";
					function = "gpio";
				};

				config {
					pins = "gpio14", "gpio15";
					drive-strength = <2>;
					bias-pull-down;
				};
			};
		};

		/*
		   In accordance with 80-PJ407-1A
		   UART QUP lanes are L2 (Tx) and L3 (Rx)

		   SE11 (aka SSC QUP 3) Tx pin is 12
		   SE11 (aka SSC QUP 3) Rx pin is 13
		*/
		qupv3_se11_2uart_pins: qupv3_se11_2uart_pins {
			qupv3_se11_2uart_active: qupv3_se11_2uart_active {
				mux {
					pins = "gpio12", "gpio13";
					function = "func1";
				};

				config {
					pins = "gpio12", "gpio13";
					drive-strength = <2>;
					bias-disable;
				};
			};

			qupv3_se11_2uart_sleep: qupv3_se11_2uart_sleep {
				mux {
					pins = "gpio12", "gpio13";
					function = "gpio";
				};

				config {
					pins = "gpio12", "gpio13";
					drive-strength = <2>;
					bias-pull-up;
				};
			};
		};

		/*
		   In accordance with 80-PJ407-1A

		   UART QUP lanes are L2 (Tx) and L3 (Rx)

		   SE13 (aka SSC QUP 5) Tx pin is 16
		   SE13 (aka SSC QUP 5) Rx pin is 17
		*/
		qupv3_se13_2uart_pins: qupv3_se13_2uart_pins {
			qupv3_se13_2uart_active: qupv3_se13_2uart_active {
				mux {
					pins = "gpio16", "gpio17";
					function = "func1";
				};

				config {
					pins = "gpio16", "gpio17";
					drive-strength = <2>;
					bias-disable;
				};
			};

			qupv3_se13_2uart_sleep: qupv3_se13_2uart_sleep {
				mux {
					pins = "gpio16", "gpio17";
					function = "gpio";
				};

				config {
					pins = "gpio16", "gpio17";
					drive-strength = <2>;
					bias-pull-up;
				};
			};
		};
};

