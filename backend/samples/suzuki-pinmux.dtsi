
&tlmm {
	qupv3_se9_i2c_active: qupv3_se9_i2c_active {
		mux {
			pins = "gpio2", "gpio3";
			function = "func1";
		};

		config {
			pins = "gpio2", "gpio3";
			drive-strength = <6>;
			bias-disable;
		};
	};

	qupv3_se9_i2c_sleep: qupv3_se9_i2c_sleep {
		mux {
			pins = "gpio2", "gpio3";
			function = "gpio";
		};

		config {
			pins = "gpio2", "gpio3";
			drive-strength = <2>;
			bias-disable;
		};
	};

	qupv3_se5_i2c_active: qupv3_se5_i2c_active {
		mux {
			pins = "gpio14", "gpio15";
			function = "qup11";
