   "tlmm": true
  },
  "emac": {
   "label": "EMAC / Ethernet",
   "pattern": "emac|ethernet|(?<![a-z])eth(?![a-z])|phy[_ ]?int|(?<![a-z0-9])(ptp|pps)(?![a-z])",
   "tlmm": true
  },
  "sgmii": {
   "label": "SGMII",
   "pattern": "sgmii|serdes",
   "tlmm": false,
   "note": "SGMII runs on a dedicated SerDes lane pair, not on TLMM pins: there is no pinctrl state to generate. Its settings (phy-mode, PHY address) are in the controller node."
  }
